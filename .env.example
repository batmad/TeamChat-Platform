# ============================================================
# TEAMCHAT PLATFORM - Example Environment Configuration
# Copy this file to .env and replace all non-local placeholders.
# Never commit production secrets.
# ============================================================

# App
APP_NAME="Realtime TeamChat Platform"
APP_URL="http://localhost:3000"
PORT=3000
APP_ORIGIN="localhost"
APP_BASE_PATH=""

# Metadata
# next.config.ts exposes these to the browser as NEXT_PUBLIC_METADATA_*.
METADATA_TITLE="TeamChat Platform"
METADATA_DESCRIPTION="Central realtime floating chat platform"

# PostgreSQL internal database
DATABASE_URL="postgresql://chat_app:chat_app_password@localhost:5432/realtime_chat?schema=public"

# Cookie
# Set true when served through HTTPS in production.
COOKIE_SECURE=false

# Main dashboard/admin session
# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret-minimum-32-characters"
SESSION_TTL_SECONDS=28800

# Chat widget authentication
# Dedicated signing secret for external widget chat sessions.
CHAT_SESSION_SECRET="replace-with-a-separate-chat-session-secret-minimum-32-characters"
CHAT_SESSION_TTL_SECONDS=28800

# Maximum lifetime accepted for host-generated bootstrap tokens.
WIDGET_BOOTSTRAP_MAX_TTL_SECONDS=300

# Application signing credential encryption
# Encrypts host-application signing secrets stored by TeamChat.
APPLICATION_CREDENTIAL_ENCRYPTION_KEY="replace-with-a-separate-credential-encryption-key-minimum-32-characters"

# Integration secret encryption
# Encrypts stored database/API integration credentials.
# Generate with: openssl rand -base64 48
INTEGRATION_ENCRYPTION_KEY="replace-with-a-separate-random-secret-minimum-32-characters"

# Attachment storage credential encryption
# Used when TeamChat stores STATIC AWS S3 / MinIO / S3-compatible credentials.
# Not required for ordinary LOCAL attachment storage.
# Keep this value stable after external-storage credentials have been saved.
# Generate with: openssl rand -base64 48
STORAGE_CREDENTIAL_ENCRYPTION_KEY="replace-with-a-separate-storage-encryption-key-minimum-32-characters"

# ROOT bootstrap (used by `npm run prisma:seed`)
ROOT_USERNAME="root"
ROOT_NAME="System Root"
ROOT_PASSWORD="change-this-strong-password"

# Logging
LOG_LEVEL="debug"

# Realtime Socket.IO service (same repository, dedicated process)
REALTIME_URL="http://localhost:3001"
REALTIME_HOST="0.0.0.0"
REALTIME_PORT=3001
REALTIME_PATH="/socket.io"
REALTIME_PING_INTERVAL_MS=25000
REALTIME_PING_TIMEOUT_MS=20000
REALTIME_HEARTBEAT_INTERVAL_MS=25000
REALTIME_OFFLINE_GRACE_MS=15000
REALTIME_CONNECTION_RECOVERY_MS=120000
REALTIME_MESSAGE_RATE_LIMIT_WINDOW_MS=10000
REALTIME_MESSAGE_RATE_LIMIT_MAX=30
PRESENCE_CLEANUP_INTERVAL_MS=3600000

# ------------------------------------------------------------
# Optional attachment release smoke-test variables
# Used only when intentionally running authenticated attachment
# smoke checks with scripts/verify-attachment-release.mjs.
# Do not store production session tokens in committed files.
# ------------------------------------------------------------
# ATTACHMENT_SMOKE_BASE_URL="http://localhost:3000"
# ATTACHMENT_SMOKE_TOKEN=""
# ATTACHMENT_SMOKE_SCOPE="PRIVATE"
# ATTACHMENT_SMOKE_FILE="./sample.pdf"

# ------------------------------------------------------------
# Host application bootstrap-token example variables
# These are typically configured in the HOST APPLICATION that
# creates bootstrap tokens, not necessarily in TeamChat itself.
# ------------------------------------------------------------
# CHAT_SIGNING_KEY_ID=""
# CHAT_SIGNING_SECRET=""
